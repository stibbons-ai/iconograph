diff --git a/docs/adr/0014-lane-loops-over-one-iteration-step.md b/docs/adr/0014-lane-loops-over-one-iteration-step.md
index f06893abf..c3e964385 100644
--- a/docs/adr/0014-lane-loops-over-one-iteration-step.md
+++ b/docs/adr/0014-lane-loops-over-one-iteration-step.md
@@ -11,6 +11,6 @@ A Lane is a nested Mastra workflow that repeats a single `iteration` step with `
 ## Consequences
 
 - Durability doesn't depend on the step boundary: every phase finds what an earlier, interrupted execution stored (Candidates, outcomes, judgements, the next Iteration's Prompt, the Lane's stop reason, numbered calls), so a call whose result was stored is never made again; one whose call ran but whose result was lost is made again, under the next attempt number, and billed again. The loop's state between passes is the small `LaneState` (ids, the Lane's model, Iteration number, stop reason).
-- Cancelling is recorded by the Run workflow's `onFinish` hook, not by the step: it marks every Lane without a stop reason `cancelled`, so a cancel during preparation, between passes, or with Lanes still waiting their turn stops them too. Closing the application waits up to 10 s for those recordings; a report of a Run Mastra stored as cancelled shows Lanes whose recording was cut off as `cancelled`.
+- Cancelling is recorded by the Run workflow's `onFinish` hook, not by the step: it marks every Lane without a stop reason `cancelled`, so a cancel during preparation, between passes, or with Lanes still waiting their turn stops them too. Closing the application waits up to 5 s for those recordings; a report of a Run Mastra stored as cancelled shows Lanes whose recording was cut off as `cancelled`.
 - Mastra's snapshots and streams show Iterations, not their phases; per-phase progress events, if wanted, are written from inside the step.
 - Revisit when Mastra gives each pass of a nested-workflow loop its own run id, or cancels it through the parent's signal.
diff --git a/packages/adapters/src/api-key.ts b/packages/adapters/src/api-key.ts
index 044661042..11d71fa35 100644
--- a/packages/adapters/src/api-key.ts
+++ b/packages/adapters/src/api-key.ts
@@ -30,3 +30,30 @@ export function apiKeyFromEnv(
 /** Removes an API key from error text, e.g. from a runtime rejecting the header value. */
 export const redactKey = (apiKey: string) => (text: string) =>
   apiKey ? text.replaceAll(apiKey, "[redacted]") : text;
+
+/**
+ * Where every vendor reason is cut (vendor text, runtime errors and our own
+ * prefix alike). The stored reason can run slightly longer: `… (truncated)`
+ * is appended, and `[redacted]` can be longer than the mask it replaces.
+ */
+const MAX_REASON_LENGTH = 2000;
+
+/**
+ * A vendor reason fit to store and print: without the key (`redactKey`), cut
+ * to about `MAX_REASON_LENGTH` characters, and without a masked echo of any
+ * key (e.g. `sk-proj-****abcd`): a whitespace-delimited word with three or
+ * more asterisks after at least three characters (trailing punctuation
+ * kept). The key goes before truncating, so a cut can't leave part of it;
+ * the lookbehind starts a match only at a word's start, so the scan stays
+ * cheap.
+ */
+export const redactReason = (apiKey: string) => {
+  const withoutKey = redactKey(apiKey);
+  return (text: string) => {
+    const keyless = withoutKey(text);
+    const masked = keyless
+      .slice(0, MAX_REASON_LENGTH)
+      .replace(/(?<!\S)\S{3,}\*{3,}\S*?(?=[.,;:!?)"']*(?:\s|$))/g, "[redacted]");
+    return keyless.length > MAX_REASON_LENGTH ? `${masked}… (truncated)` : masked;
+  };
+};
