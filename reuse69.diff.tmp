+        level: "Warn",
+        warning: `Cancelled Runs ${runIds.join(", ")} were still unwinding after ${timeoutMs / 1000} s; closing without recording their Lanes`,
+        runIds,
+      });
     } finally {
       clearTimeout(timer);
     }
