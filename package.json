{
  "name": "iconograph",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "run": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun packages/server/src/cli.ts",
    "eval": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun packages/eval-harness/src/cli.ts",
    "models:fetch": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun packages/adapters/src/models-cli.ts",
    "models:export-facenet": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun packages/adapters/src/models-export-cli.ts",
    "faces:calibrate": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun packages/adapters/src/calibrate-cli.ts",
    "faces:heldout": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun packages/adapters/src/heldout-cli.ts",
    "photos:validate": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun packages/adapters/src/photos-cli.ts",
    "prices": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun packages/adapters/src/prices-cli.ts",
    "prices:snapshot": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun scripts/update-price-snapshot.ts",
    "serve": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun packages/server/src/server.ts",
    "build:server": "bun scripts/build-server.ts",
    "test": "MASTRA_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun test",
    "format": "oxfmt --write package.json tsconfig.json .oxfmtrc.json .oxlintrc.json packages scripts .github docs/adr README.md",
    "format:check": "oxfmt --check package.json tsconfig.json .oxfmtrc.json .oxlintrc.json packages scripts .github docs/adr README.md",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "licenses": "bun scripts/check-licenses.ts",
    "hooks:install": "bun scripts/install-hooks.ts",
    "adrs:check": "bun scripts/check-adrs.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run licenses && bun run adrs:check && bun run test"
  },
  "catalog": {
    "@ai-sdk/anthropic": "3.0.133",
    "@ai-sdk/google": "3.0.135",
    "@ai-sdk/openai": "3.0.130",
    "@libsql/client": "0.18.0",
    "@mastra/core": "1.80.0",
    "@mastra/hono": "1.7.22",
    "@mastra/libsql": "1.27.1",
    "@types/bun": "1.4.4",
    "@types/spdx-expression-parse": "4.0.0",
    "effect": "4.1.2",
    "hono": "4.13.14",
    "libheif-js": "1.23.5",
    "onnxruntime-node": "1.31.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "sharp": "0.35.5",
    "spdx-expression-parse": "5.0.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/spdx-expression-parse": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "spdx-expression-parse": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
