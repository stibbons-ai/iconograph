# Copy to .env (git-ignored) and fill in. Keys are read from the environment only:
# never stored in the database, the image or a log. A Run needs the key of its
# Judge's vendor, of its Optimizer's vendor (unless it has only one Iteration,
# which never calls the Optimizer) and of every Lane's Image Model; it fails on
# the first one missing (the Judge's, then the Optimizer's, then each Lane's),
# before any billable call.

# Anthropic (the default Judge and Optimizer, anthropic/claude-sonnet-5-5): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI (an OpenAI Lane, or an openai/ Judge or Optimizer): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini (a Gemini Lane): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# A google/ Judge or Optimizer reads GOOGLE_GENERATIVE_AI_API_KEY (or GOOGLE_API_KEY) instead.
